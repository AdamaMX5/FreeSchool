# Copy to .env. The client talks directly to the microservices (no FreeSchool backend).
VITE_AUTH_BASE_URL=https://auth.freischule.info
VITE_OBJECT_BASE_URL=https://object.freischule.info
VITE_FORUM_BASE_URL=https://forum.freischule.info
# Root "Thema" node id shown by the header forum button — create it in the
# ForumService first, then paste its node id here. Leave empty to show a
# placeholder instead of the forum.
VITE_FORUM_ROOT_NODE_ID=
